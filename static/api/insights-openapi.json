{
  "openapi": "3.1.0",
  "info": {
    "title": "Fishjam Insights API",
    "version": "1.0.0",
    "description": "Browse your Fishjam rooms that ended in the last 60 days. For each room, see which peers had issues such as high round trip time or packet loss, and how their bitrate changed over time. Authenticate with your management token."
  },
  "paths": {
    "/insights/rooms": {
      "get": {
        "operationId": "list_insights_rooms",
        "summary": "List rooms with their issue counts",
        "parameters": [
          {
            "in": "query",
            "name": "start",
            "schema": {
              "format": "date-time",
              "title": "Start",
              "type": "string"
            },
            "required": true
          },
          {
            "in": "query",
            "name": "end",
            "schema": {
              "format": "date-time",
              "title": "End",
              "type": "string"
            },
            "required": true
          },
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "default": 20,
              "maximum": 1000,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            },
            "required": false
          },
          {
            "in": "query",
            "name": "offset",
            "schema": {
              "default": 0,
              "maximum": 4294967295,
              "minimum": 0,
              "title": "Offset",
              "type": "integer"
            },
            "required": false
          }
        ],
        "responses": {
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Message"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Message"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Content",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Message"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Message"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Message"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Message"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RoomsPageOut"
                }
              }
            }
          }
        },
        "description": "Rooms that were both created and ended inside the window, newest first.",
        "tags": ["Rooms"],
        "security": [
          {
            "ManagementTokenAuth": []
          }
        ]
      }
    },
    "/insights/rooms/{room_id}": {
      "get": {
        "operationId": "get_insights_room",
        "summary": "Get a room with its peers and their issues",
        "parameters": [
          {
            "in": "path",
            "name": "room_id",
            "schema": {
              "title": "Room Id",
              "type": "string"
            },
            "required": true
          }
        ],
        "responses": {
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Message"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Message"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Content",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Message"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Message"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Message"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Message"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RoomDetailOut"
                }
              }
            }
          }
        },
        "description": "An ended room with its peers and their issues.",
        "tags": ["Rooms"],
        "security": [
          {
            "ManagementTokenAuth": []
          }
        ]
      }
    },
    "/insights/rooms/{room_id}/peers/{peer_id}": {
      "get": {
        "operationId": "get_insights_room_peer",
        "summary": "Get a peer and its issues",
        "parameters": [
          {
            "in": "path",
            "name": "room_id",
            "schema": {
              "title": "Room Id",
              "type": "string"
            },
            "required": true
          },
          {
            "in": "path",
            "name": "peer_id",
            "schema": {
              "title": "Peer Id",
