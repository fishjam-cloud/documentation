    "/insights/rooms/{room_id}/peers/{peer_id}/events": {
      "get": {
        "operationId": "get_insights_room_peer_events",
        "summary": "Get a peer's timeline",
        "parameters": [
          {
            "in": "path",
            "name": "room_id",
            "schema": {
              "title": "Room Id",
              "type": "string"
            },
            "required": true
          },
          {
            "in": "path",
            "name": "peer_id",
            "schema": {
              "title": "Peer Id",
