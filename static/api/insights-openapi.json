  },
  "components": {
    "schemas": {
      "PublicRoomsQueryIn": {
        "properties": {
          "start": {
            "format": "date-time",
            "title": "Start",
            "type": "string"
          },
          "end": {
            "format": "date-time",
            "title": "End",
            "type": "string"
          },
          "limit": {
            "default": 20,
            "maximum": 1000,
            "minimum": 1,
            "title": "Limit",
            "type": "integer"
          },
          "offset": {
            "default": 0,
            "maximum": 4294967295,
            "minimum": 0,
            "title": "Offset",
            "type": "integer"
          }
        },
        "required": ["start", "end"],
        "title": "PublicRoomsQueryIn",
        "type": "object"
      },
      "Message": {
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "string"
          }
        },
        "required": ["detail"],
        "title": "Message",
        "type": "object"
      },
      "RoomOut": {
        "properties": {
          "room_id": {
            "title": "Room Id",
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "ended_at": {
            "format": "date-time",
            "title": "Ended At",
            "type": "string"
          },
          "end_reason": {
            "enum": ["deleted", "purged", "crashed"],
            "title": "End Reason",
            "type": "string",
            "x-enumDescriptions": {
              "crashed": "Room crashed on our side.",
              "deleted": "Room closed normally.",
              "purged": "Room closed after everyone left."
            }
          },
          "peer_count": {
            "title": "Peer Count",
            "type": "integer"
          },
          "issues_count": {
            "title": "Issues Count",
            "type": "integer"
          }
        },
        "required": [
          "room_id",
          "created_at",
          "ended_at",
          "end_reason",
          "peer_count",
          "issues_count"
        ],
        "title": "RoomOut",
        "type": "object"
      },
      "RoomsPageOut": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/RoomOut"
            },
            "title": "Items",
            "type": "array"
          },
          "count": {
            "title": "Count",
            "type": "integer"
          }
        },
        "required": ["items", "count"],
        "title": "RoomsPageOut",
        "type": "object"
      },
      "IssueOut": {
        "properties": {
          "code": {
            "enum": [
              "high_packet_loss",
              "high_rtt",
              "crashed",
              "connect_failed",
              "dropped"
            ],
            "title": "Code",
            "type": "string",
            "x-enumDescriptions": {
              "connect_failed": "The peer's media connection couldn't be set up.",
              "crashed": "The peer crashed on our side.",
              "dropped": "The peer's media connection broke during the call.",
              "high_packet_loss": "Packet loss at or above the limit.",
              "high_rtt": "Round trip time at or above the limit."
            }
          }
        },
        "required": ["code"],
        "title": "IssueOut",
        "type": "object"
      },
      "MetadataEntryOut": {
        "properties": {
          "key": {
            "title": "Key",
            "type": "string"
          },
          "value": {
            "title": "Value",
            "type": "string"
          }
        },
        "required": ["key", "value"],
        "title": "MetadataEntryOut",
        "type": "object"
      },
      "PeerOut": {
        "properties": {
          "peer_id": {
            "title": "Peer Id",
            "type": "string"
          },
          "sdk": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sdk"
          },
          "first_joined_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "When the peer first joined. `null` if the peer never connected.",
            "title": "First Joined At"
          },
          "last_left_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "When the peer last left or crashed. `null` if the peer never joined or we don't know when it last left, e.g. the room crashed.",
            "title": "Last Left At"
          },
          "metadata": {
            "items": {
              "$ref": "#/components/schemas/MetadataEntryOut"
            },
            "title": "Metadata",
            "type": "array"
          },
          "issues": {
            "items": {
              "$ref": "#/components/schemas/IssueOut"
            },
            "title": "Issues",
            "type": "array"
          },
          "peer_type": {
            "enum": ["webrtc", "agent", "vapi"],
            "title": "Peer Type",
            "type": "string"
          },
          "time_in_room_ms": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Time spent in the room. `null` if the peer never joined or we don't know when it last left, e.g. the room crashed.",
            "title": "Time In Room Ms"
          },
          "time_outside_ms": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Time away between leaving and rejoining. `null` if the peer never joined or we don't know when it last left, e.g. the room crashed.",
            "title": "Time Outside Ms"
          },
          "reconnects": {
            "description": "How many times the peer joined again.",
            "title": "Reconnects",
            "type": "integer"
          }
        },
        "required": [
          "peer_id",
          "sdk",
          "first_joined_at",
          "last_left_at",
          "metadata",
          "issues",
          "peer_type",
          "time_in_room_ms",
          "time_outside_ms",
          "reconnects"
        ],
        "title": "PeerOut",
        "type": "object"
      },
      "RoomDetailOut": {
        "properties": {
          "room": {
            "$ref": "#/components/schemas/RoomOut"
          },
          "peers": {
            "items": {
              "$ref": "#/components/schemas/PeerOut"
            },
            "title": "Peers",
            "type": "array"
          },
          "participant_time_ms": {
            "description": "WebRTC participant time of the room, summed over its peers.",
            "title": "Participant Time Ms",
            "type": "integer"
          },
          "thresholds": {
            "$ref": "#/components/schemas/ThresholdsOut"
          }
        },
        "required": ["room", "peers", "participant_time_ms", "thresholds"],
        "title": "RoomDetailOut",
        "type": "object"
      },
      "ThresholdsOut": {
        "properties": {
          "packet_loss_pct": {
            "description": "Packet loss limit, in %. At or above it a peer has the `high_packet_loss` issue.",
            "title": "Packet Loss Pct",
            "type": "number"
          },
          "rtt_ms": {
            "description": "Round trip time limit, in ms. At or above it a peer has the `high_rtt` issue.",
            "title": "Rtt Ms",
            "type": "number"
          }
        },
        "required": ["packet_loss_pct", "rtt_ms"],
        "title": "ThresholdsOut",
        "type": "object"
      },
      "PeerRttPointOut": {
        "properties": {
          "timestamp": {
            "format": "date-time",
            "title": "Timestamp",
            "type": "string"
          },
          "rtt_ms": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Round trip time, in ms. `null` if the peer's app never reported back.",
            "title": "Rtt Ms"
          }
        },
        "required": ["timestamp", "rtt_ms"],
        "title": "PeerRttPointOut",
        "type": "object"
      },
      "PeerSeriesOut": {
        "properties": {
          "series": {
            "description": "Bitrate and packet loss per report, track kind and direction.",
            "items": {
              "$ref": "#/components/schemas/PeerSeriesPointOut"
            },
            "title": "Series",
            "type": "array"
          },
          "rtt": {
            "items": {
              "$ref": "#/components/schemas/PeerRttPointOut"
            },
            "title": "Rtt",
            "type": "array"
          },
          "thresholds": {
            "$ref": "#/components/schemas/ThresholdsOut"
          }
        },
        "required": ["series", "rtt", "thresholds"],
        "title": "PeerSeriesOut",
        "type": "object"
      },
      "PeerSeriesPointOut": {
        "properties": {
          "timestamp": {
            "format": "date-time",
            "title": "Timestamp",
            "type": "string"
          },
          "direction": {
            "enum": ["inbound", "outbound"],
            "title": "Direction",
            "type": "string",
            "x-enumDescriptions": {
              "inbound": "Sent. Media the peer sent to Fishjam.",
              "outbound": "Received. Media the peer received from Fishjam."
            }
          },
          "kind": {
            "enum": [
              "microphone",
              "camera",
              "screenShareVideo",
              "screenShareAudio",
              "customVideo",
              "customAudio",
              "audio",
              "video"
            ],
            "title": "Kind",
            "type": "string"
          },
          "bitrate_bps": {
            "description": "Bitrate, in bits per second, since the previous report.",
            "title": "Bitrate Bps",
            "type": "number"
          },
          "packet_loss_pct": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Packet loss, in %. `null` if no packets were expected.",
            "title": "Packet Loss Pct"
          }
        },
        "required": [
          "timestamp",
          "direction",
          "kind",
          "bitrate_bps",
          "packet_loss_pct"
        ],
        "title": "PeerSeriesPointOut",
        "type": "object"
      },
      "PeerConnectionEventOut": {
        "properties": {
          "timestamp": {
            "format": "date-time",
            "title": "Timestamp",
            "type": "string"
          },
          "type": {
            "enum": ["connected", "connect_failed", "dropped"],
            "title": "Type",
            "type": "string",
            "x-enumDescriptions": {
              "connect_failed": "Media connection couldn't be set up.",
              "connected": "Media connection established.",
              "dropped": "Media connection broke during the call."
            }
          }
        },
        "required": ["timestamp", "type"],
        "title": "PeerConnectionEventOut",
        "type": "object"
      },
      "PeerEventsOut": {
        "properties": {
          "events": {
            "description": "Sorted by time.",
            "items": {
              "discriminator": {
                "mapping": {
                  "connect_failed": "#/components/schemas/PeerConnectionEventOut",
                  "connected": "#/components/schemas/PeerConnectionEventOut",
                  "crashed": "#/components/schemas/PeerPresenceEventOut",
                  "dropped": "#/components/schemas/PeerConnectionEventOut",
                  "joined": "#/components/schemas/PeerPresenceEventOut",
                  "left": "#/components/schemas/PeerPresenceEventOut",
                  "track_added": "#/components/schemas/PeerTrackEventOut",
                  "track_paused": "#/components/schemas/PeerTrackEventOut",
                  "track_removed": "#/components/schemas/PeerTrackEventOut",
                  "track_resumed": "#/components/schemas/PeerTrackEventOut"
                },
                "propertyName": "type"
              },
              "oneOf": [
                {
                  "$ref": "#/components/schemas/PeerPresenceEventOut"
                },
                {
                  "$ref": "#/components/schemas/PeerConnectionEventOut"
                },
                {
                  "$ref": "#/components/schemas/PeerTrackEventOut"
                }
